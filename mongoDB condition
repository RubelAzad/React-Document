//table name is User and table field

const userSchema = new mongoose.Schema({
    name: String,
    age: Number,
    isMarried: Boolean,
    salary: Number,
    address: String,
    gender: String,
    date: Date,
    email: String,
    phone: Number,
    password: String,

});
const User = mongoose.model('User', userSchema);
