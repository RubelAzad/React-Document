async function fetchInformation(){

    const user = await User.findOneAndUpdate({_id: '6683888b327f9db34f7f55a3'},{
        age:2,
        isMarried: false,
        salary: 500,
    },{
        new: true,
        runValidators: true
    });
    await user.save();
}
fetchInformation();

 
