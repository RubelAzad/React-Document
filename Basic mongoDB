const mongoose = require('mongoose');

// database name is testdb
mongoose.connect('mongodb://127.0.0.1:27017/testdb').then(() => console.log('Database is connected')).catch((err) => console.log(err)); 

//schema (Shape of a document with properties)

//Document, Collection, Database
//individual object call is Document
//multiple object/document call is collection
//multiple collection is call database

//table name is User and table field

const userSchema = new mongoose.Schema({
    name: String,
    age: Number,
    isMarried: Boolean,
    salary: Number,
    address: String,
    gender: String,
    date: Date,
    email: String,
    phone: Number,
    password: String,

});
const User = mongoose.model('User', userSchema);

